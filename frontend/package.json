{
  "name": "frontend",
  "version": "0.1.14",
  "private": true,
  "description": "学枢 — AI 个性化学习平台桌面端",
  "author": "学枢团队",
  "main": "electron/main.js",
  "scripts": {
    "prepare:voice-assets": "node scripts/copy-vad-assets.mjs",
    "prepare:sandbox-runtime": "node scripts/copy-sandbox-runtime.mjs",
    "prepare:python-runtime": "node scripts/prepare-python-runtime.mjs",
    "prepare:electron-app": "node scripts/prepare-electron-app.mjs",
    "prepare:knowledge-seed": "node scripts/prepare-knowledge-seed.mjs",
    "prepare:remotion-runtime": "node scripts/prepare-remotion-runtime.mjs",
    "predev": "npm run prepare:voice-assets && npm run prepare:sandbox-runtime",
    "prebuild": "npm run prepare:voice-assets && npm run prepare:sandbox-runtime",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
    "smoke:desktop-routes": "node tests/desktop-routes-smoke.mjs",
    "lint": "eslint",
    "app:preview": "electron .",
    "preapp:pack": "npm run prepare:python-runtime && npm run prepare:knowledge-seed && npm run prepare:remotion-runtime",
    "app:pack": "npm run build && npm run prepare:electron-app && electron-builder --win nsis",
    "preapp:dist": "npm run prepare:python-runtime && npm run prepare:knowledge-seed && npm run prepare:remotion-runtime",
    "app:dist": "npm run build && npm run prepare:electron-app && electron-builder --win"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@ricky0123/vad-web": "^0.0.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "page-flip": "^2.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "three": "^0.182.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
