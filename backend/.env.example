# 学枢环境变量配置
# 复制此文件为 .env 并填入实际值

# ── 应用 ──
APP_NAME=学枢
DEBUG=true

# ── 数据库 ──
DATABASE_URL=sqlite+aiosqlite:///./smartlearn.db
SQL_ECHO=false
# Set a long random value when running multiple backend workers so approval
# markers issued by one worker can be verified by another.
MATERIAL_APPROVAL_SECRET=

# ── Chroma 向量库 ──
CHROMA_PERSIST_DIR=./chroma
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_ADJACENT_CHUNK_DEDUP=true
# Optional local CrossEncoder directory/model. Leave empty to disable reranking.
RAG_RERANKER_MODEL=
RAG_RERANKER_CANDIDATES=12

# ── LLM Provider 首次启动预设 ──
# 首次启动会把以下配置导入本机 SQLite。之后请在“设置 -> 模型与服务”中
# 新增或编辑任意 OpenAI 兼容的 Base URL、API Key 和模型名称。
DEFAULT_LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

SPARK_API_KEY=
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
SPARK_MODEL=generalv3.5
SPARK_APPID=
SPARK_API_SECRET=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── 讯飞 ──
IFLYTEK_APPID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_TTS_ENABLED=false
IFLYTEK_TTS_URL=wss://tts-api.xfyun.cn/v2/tts
IFLYTEK_IAT_URL=wss://iat-api.xfyun.cn/v2/iat
IFLYTEK_OCR_URL=https://webapi.xfyun.cn/v1/ai/v1/ocr

# ── 讯飞图片理解与 PDF OCR（留空时可复用下方数字人凭据） ──
IFLYTEK_VISION_APPID=
IFLYTEK_VISION_API_KEY=
IFLYTEK_VISION_API_SECRET=
IFLYTEK_VISION_URL=wss://spark-api.cn-huabei-1.xf-yun.com/v2.1/image
IFLYTEK_PDF_OCR_APPID=
IFLYTEK_PDF_OCR_API_SECRET=
IFLYTEK_PDF_OCR_START_URL=https://iocr.xfyun.cn/ocrzdq/v1/pdfOcr/start
IFLYTEK_PDF_OCR_STATUS_URL=https://iocr.xfyun.cn/ocrzdq/v1/pdfOcr/status
IFLYTEK_PDF_OCR_TIMEOUT_SECONDS=120

# ── 讯飞实时 2D 数字人（独立应用凭据） ──
# 长期密钥只放后端；浏览器仅获得约 5 分钟有效的 WebSocket 签名 URL。
IFLYTEK_AVATAR_APPID=
IFLYTEK_AVATAR_API_KEY=
IFLYTEK_AVATAR_API_SECRET=
IFLYTEK_AVATAR_ID=
IFLYTEK_AVATAR_SCENE_ID=
IFLYTEK_AVATAR_VCN=x4_lingxiaoxuan_oral

# ── Xiaomi MiMo ASR / TTS ──
MIMO_ASR_ENABLED=false
MIMO_ASR_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_ASR_LANGUAGE=auto
MIMO_ASR_MAX_SECONDS=120
MIMO_TTS_ENABLED=false
MIMO_API_KEY=
MIMO_TTS_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=茉莉
MIMO_TTS_STYLE=自然、清晰、有亲和力的教学讲解，语速适中，重点词稍作停顿。

# ── MiniMax TTS（可选；启用后优先使用原生字幕时间戳） ──
MINIMAX_TTS_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_URL=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE_ID=male-qn-qingse
MINIMAX_TTS_SPEED=1.0
MINIMAX_VOICE_CLONE_UPLOAD_URL=https://api.minimaxi.com/v1/files/upload
MINIMAX_VOICE_CLONE_URL=https://api.minimaxi.com/v1/voice_clone
MINIMAX_VOICE_CLONE_SOURCE=

# ── 媒体渲染 ──
MEDIA_OUTPUT_DIR=./media/output
MANIM_QUALITY=low_quality
# 可选：按分镜关键词检索相关背景视频；留空时使用品牌动画画面
PEXELS_API_KEY=
# 可选：持久发音词典 JSON/文本文件与已获授权的背景音乐目录
MEDIA_PRONUNCIATION_LEXICON_PATH=../knowledge/pronunciation.json
MEDIA_MUSIC_DIR=

# ── 知识库 ──
KNOWLEDGE_DIR=../knowledge
